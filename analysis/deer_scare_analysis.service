[Unit]
Description=Scare Deer Analysis
After=multi-user.target
BindsTo=deer_scare_camera.service

[Service]
Type=simple
WorkingDirectory=/opt/scare-deer
EnvironmentFile=/opt/scare-deer/analysis/.env
ExecStart=/opt/scare-deer/nalysis/.analysis_env/bin/python3 -m analysis.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target